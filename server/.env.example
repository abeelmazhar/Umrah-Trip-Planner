PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/umrah-trip-planner?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Web Push. Generate a key pair with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for POST /api/cron/notifications (cron-job.org). Not a user JWT.
CRON_SECRET=change-me-to-a-long-random-string
# AI Pilgrim Assistant. Create a key at https://console.anthropic.com/ (secret, never commit it).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_DAILY_LIMIT=30
