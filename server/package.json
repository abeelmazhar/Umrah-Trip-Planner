{
  "name": "umrah-trip-planner-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "test": "jest && node --test tests/integration/trips.itest.js",
    "test:unit": "jest",
    "test:integration": "node --test --test-reporter=spec tests/integration/trips.itest.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server-core": "^11.4.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
